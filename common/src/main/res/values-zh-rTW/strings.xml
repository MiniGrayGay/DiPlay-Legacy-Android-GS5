    <string name="hotspot_network_not_ready">熱點網路未就緒</string>
    <string name="first_tcp_timeout">等待 iPhone 接入 CarPlay 超時</string>
    <string name="wireless_startup_retries_exhausted">自動再試一次已停止，請檢查連線後手動再試一次。</string>
    <string name="wireless_forget_device_title">無線連線連續失敗</string>
    <string name="wireless_forget_device_message">無線 CarPlay 已連續 4 次建立連線失敗。請到 iPhone「設定 → Wi-Fi」中找到車機熱點，忽略此裝置後重新配對連線。</string>
    <string name="wired_no_tcp_replug_required">連接反覆失敗。請拔下 iPhone 重新插入，然後點選重試。</string>
    <string name="retry_carplay_connection">重新連線</string>
    <string name="car_button_description">CarPlay 會在應用程式列表中顯示此圖示和名稱。點選後可返回車機原有畫面。變更會在下次連線至 CarPlay 時生效。自訂圖片會自動縮小至不超過 512×512 像素、256 KB。</string>
    <string name="car_button_icon">圖示</string>
    <string name="car_button_icon_custom">自訂圖示</string>
    <string name="car_button_in_carplay">CarPlay 中的車輛按鈕</string>
    <string name="car_button_name">名稱</string>
    <string name="car_button_saved_next_connection">已儲存。下次連線時，CarPlay 會顯示新的圖示和名稱。</string>
    <string name="carplay_call_controls_experimental">CarPlay 通話按鍵（實驗性）</string>
    <string name="carplay_call_controls_experimental_description">用方向盤按鍵接聽和掛斷 CarPlay 電話。廣汽車機上：接聽鍵接聽，掛斷鍵掛斷或拒接，短按或長按語音鍵喚起 Siri，CarPlay 連線期間車機內建的語音助理和喚醒詞暫停；CarPlay 連線期間不彈出車機內建的通話畫面。DiLink 3 上的按鍵尚未驗證。仍需實車測試。預設關閉；儀表通話卡片為獨立設定。</string>
    <string name="carplay_dock">CarPlay 程式列</string>
    <string name="carplay_dock_automatic">自動</string>
    <string name="carplay_dock_bottom">底部</string>
    <string name="carplay_dock_driver_side">駕駛側</string>
    <string name="settings_dock_auto_hide">自動隱藏側邊欄</string>
    <string name="settings_dock_auto_hide_description">全螢幕顯示右側應用區域，從螢幕左側邊緣向右滑動即可呼出應用側邊欄</string>
    <string name="settings_force_square_corners">強制直角顯示</string>
    <string name="settings_force_square_corners_description">停用 CarPlay 畫面的圓角切角；在直角車機螢幕上開啟，避免邊緣內容被遮擋。下次連線時生效。</string>
    <string name="carplay_dock_hint">CarPlay 顯示應用程式、時鐘與狀態的位置。在「駕駛側」和「底部」之間切換會立即生效；「自動」由 iPhone 決定，重新連線後生效。</string>
    <string name="carplay_rotation">旋轉螢幕時同步旋轉 CarPlay，無須重新連線</string>
    <string name="carplay_rotation_description">適用於螢幕可旋轉的車機。CarPlay 會接收包含橫向和直向畫面的方形影像，旋轉螢幕時可直接重繪，無須重新連線。較大的方形影像可能增加影片處理負擔並降低流暢度，尤其在大螢幕上選擇「較清晰」時。若很少旋轉螢幕，關閉此選項可能更合適。自訂安全區域不適用於方形影像。下次連線時生效。</string>
    <string name="carplay_rotation_picture">方形影像</string>
    <string name="carplay_rotation_sharper">較清晰（螢幕尺寸）</string>
    <string name="carplay_rotation_smoother">較流暢（1920）</string>
    <string name="cluster_size_smallest">較小 · 地圖範圍較廣、細節較多</string>
    <string name="cluster_resolution">儀表板解析度</string>
    <string name="cluster_resolution_hint">輸入 30–160 百分比，儲存後重新連線 CarPlay 生效。</string>
    <string name="cluster_frame_rate">儀表板幀率</string>
    <string name="cluster_fps_hint">輸入 1–30 幀率，儲存後重新連線 CarPlay 生效。</string>
    <string name="fps_hint">輸入 1–60 幀率，儲存後重新連線 CarPlay 生效。</string>
    <string name="fps_summary">%1$d 幀</string>
    <string name="main_buffered_audio">緩衝音樂（實驗性）</string>
    <string name="main_buffered_audio_description">支援此功能的應用程式（例如 Apple Music）可預先傳送約兩分鐘的音樂，因此短暫的 Wi-Fi 中斷不會影響播放。其他應用程式仍使用一般串流。變更後會重新連線至 CarPlay。</string>
    <string name="settings_car_bluetooth_audio">透過車輛藍牙播放 CarPlay 音訊（實驗性）</string>
    <string name="settings_car_bluetooth_audio_description">DiPlay 不向 iPhone 提供 CarPlay 音訊，因此音樂、導航和通話應透過 iPhone 與車輛的藍牙連線傳輸。請保持 iPhone 與車輛配對，並將車輛音源設為藍牙。如果聲音改從 iPhone 播放，請關閉此選項。變更後會重新連線至 CarPlay。</string>
    <string name="settings_car_bluetooth_audio_dongle_warning">偵測到外接 USB 藍牙適配器。外接適配器本身不能播放音訊——這個功能是讓聲音走 iPhone 與車機內建藍牙的連線。如果車機內建藍牙放不了聲音（這正是大多數人用外接適配器的原因），開啟後會完全沒有聲音。</string>
    <string name="settings_car_bluetooth_audio_enable_anyway">仍然開啟</string>
    <string name="call_echo_cancellation">通話回音消除（實驗性）</string>
    <string name="call_echo_cancellation_description">嘗試減少 CarPlay 通話中傳送給對方的喇叭回音。效果取決於車用主機。下次連線至 CarPlay 時生效。</string>
    <string name="call_voice_filter">更清晰的通話人聲（實驗性）</string>
    <string name="call_voice_filter_description">削減 CarPlay 通話音訊的低音。這可能改變人聲的音色。下次連線至 CarPlay 時生效。</string>
    <string name="settings_call_mic_compatibility">通話麥克風相容模式（實驗性）</string>
    <string name="settings_call_mic_compatibility_description">通話時使用標準車機麥克風輸入（MIC）並跳過系統通訊音訊模式切換。解決全志等車機在微信或電話通話時對方聽不到聲音的問題。下次連線至 CarPlay 時生效。</string>
    <string name="smooth_video">流暢影片（實驗性）</string>
    <string name="smooth_video_description">依 iPhone 為每一幀標記的時間加上一段短延遲顯示 CarPlay 主畫面，而不是解碼後立即顯示。延遲會自動調整，讓大多數畫面能及時解碼；仍未按時準備好的畫面會立即顯示。捲動可能更平順，但觸控反應會變慢。畫面調整不適用。變更後會重新連線至 CarPlay。</string>
    <string name="side_panel">CarPlay 旁的側邊面板（實驗性）</string>
    <string name="side_panel_description">CarPlay 可移至螢幕的三分之二，其餘位置顯示 DiPlay 面板：橫向螢幕時位於乘客側，直向螢幕時位於底部（顯示時鐘，以及可讀取時的電量）。可在連線期間的選單中顯示或隱藏。下次連線時生效。</string>
    <string name="side_panel_full_screen">⤢ 全螢幕</string>
    <string name="side_panel_show">側邊面板</string>
    <string name="split_screen_areas">車機分割畫面中的 CarPlay</string>
    <string name="split_screen_areas_description">車機以分割畫面顯示 DiPlay 時，CarPlay 會依視窗大小重新繪製畫面，避免縮小後出現黑邊；返回全螢幕時也無須重新連線。首次使用時會記住視窗大小，從下次連線起即可完全貼合。若程式列設為「自動」，CarPlay 會將其放在底部。下次連線時生效。</string>
    <string name="this_head_unit_has_no_image_picker">此車機沒有圖片選擇器。</string>
    <string name="settings_interface_size">介面大小</string>
    <string name="settings_interface_size_auto">自動</string>
    <string name="settings_interface_size_hint">DiPlay 自身畫面中文字與控制項的大小。自動模式會在大尺寸低密度螢幕上放大它們。不影響 CarPlay。</string>
    <string name="settings_direct_surface_view">高效硬體圖層渲染（實驗性）</string>
    <string name="settings_direct_surface_view_description">使用系統原生硬體疊加圖層（SurfaceView）顯示畫面，繞過 GPU 視圖合成，大幅降低老舊低配車機（如 Android 4.4/6.0、聯發科 MT3561、全志 T3）的系統負載與卡頓。開啟後畫面色彩調節不可用。變更後會重新連線至 CarPlay。</string>
    <string name="bluetooth_adapter_unavailable">車機未提供原生藍牙適配器，無法進行無線連線引導。請在設定中切換為【有線連線】並使用 USB 傳輸線連線。</string>
    <string name="usb_iphone_busy_or_occupied">iPhone USB 介面被原車系統或其他應用程式佔用（如原車 iPod 播放器），請在車機中退出該應用並重新拔插傳輸線。</string>
    <string name="wired_usb_stall_replug_required">iPhone 未回應 USB 配置請求（其 USB 狀態已卡死）。請拔下傳輸線、重啟 iPhone 並重新連接，然後點擊重試。</string>
    <string name="usb_iphone_permission_not_granted">未能取得 iPhone USB 權限（可能被原車系統攔截或未彈出授權視窗），請嘗試退出原車 iPod 播放器並重新插拔 USB。</string>
    <string name="bluetooth_device_connected">已連線</string>
    <string name="manual_input_mac">手動輸入 MAC</string>
    <string name="manual_bluetooth_input_mac_label">藍牙 MAC 位址（例如 AA:BB:CC:DD:EE:FF）：</string>
    <string name="manual_bluetooth_input_name_label">裝置名稱：</string>
    <string name="manual_bluetooth_input_invalid_mac">無效的 MAC 位址（格式為 XX:XX:XX:XX:XX:XX）</string>
    <string name="restart_application">重啟應用</string>
    <string name="preset_brand_icons">選擇品牌車標</string>
    <string name="car_brand_presets_title">選擇汽車品牌車標</string>
    <string name="car_brand_icon_applied">已套用 %1$s 車標</string>
    <string name="settings_car_bluetooth_mac_title">車機藍牙位址</string>
    <string name="settings_car_bluetooth_mac_subtitle">向 iPhone 宣告車機真實藍牙 MAC 位址以正常路由音訊。重新連線後生效。</string>
    <string name="settings_car_bluetooth_mac_auto">自動探測 (%1$s)</string>
    <string name="settings_car_bluetooth_mac_not_detected">未檢測到</string>
    <string name="settings_car_bluetooth_mac_dialog_title">車機藍牙 MAC 位址</string>
    <string name="settings_car_bluetooth_mac_dialog_message">輸入車機真實藍牙 MAC 位址（例如 AA:BB:CC:DD:EE:FF）。可在 iPhone「設定 → 藍牙 → (i)」或車機藍牙設定中檢視。</string>
    <string name="settings_car_bluetooth_mac_clear">清除 / 自動探測</string>
    <string name="settings_bluetooth_diagnostic">藍牙診斷</string>
    <string name="settings_log_output_title">日誌輸出</string>
    <string name="settings_log_output_subtitle">關閉可降低老車機負載，重新啟動應用後生效；需要定位問題時再開啟。</string>
    <string name="settings_car_bluetooth_mac_invalid">請輸入有效的 12 位十六進位 MAC 位址。</string>
    <string name="report_no_usb_drive">未偵測到可寫入的USB隨身碟。請連接USB隨身碟後重試，或將報告儲存至車機。</string>
    <string name="report_auto_save_locations">自動儲存至所有可寫入位置</string>
    <string name="report_usb_location">USB隨身碟：%1$s</string>
    <string name="report_usb_copy_unavailable">USB副本：找不到可寫入的USB隨身碟</string>
    <string name="report_usb_copy_paths">其他儲存位置：\n%1$s</string>
    <string name="settings_harman_fullscreen_experimental">Harman 車機全螢幕（實驗性）</string>
    <string name="settings_harman_fullscreen_experimental_description">讓 CarPlay 佔用受支援 Harman 車機的原廠側欄區域。下次開啟 CarPlay 視窗時生效；其他韌體可能顯示異常。</string>
    <string name="settings_legacy_reverse_cold_start">倒車退出延遲冷啟動（實驗性）</string>
    <string name="settings_legacy_reverse_cold_start_description">針對老舊晶片（如 MTK 8227L）：掛倒檔時徹底釋放視訊解碼器，退出倒檔 2.5 秒後再冷啟動並索取全新關鍵幀。僅在倒車退出黑屏的車機上開啟。</string>
    <string name="settings_usb_bluetooth_title">外置 USB 藍牙</string>
    <string name="settings_usb_bluetooth_subtitle">直接驅動外置 USB 藍牙適配器（支援綠聯 CM591/CM390、Realtek、炬芯 ATS2851 等），用於無線 CarPlay 數據通道。</string>
    <string name="settings_usb_bluetooth_not_detected">未檢測到外置 USB 藍牙適配器 — 請插入相容的 USB 藍牙裝置。</string>
    <string name="settings_usb_bluetooth_detected">已識別: %1$s</string>
    <string name="settings_usb_bluetooth_needs_permission">未取得 USB 存取權限 — 點擊請求授權</string>
    <string name="settings_usb_bluetooth_request_permission">授予 USB 權限</string>
    <string name="settings_usb_bluetooth_start">啟動外置藍牙服務與廣播配對</string>
    <string name="settings_usb_bluetooth_stop">停止外置藍牙服務</string>
    <string name="settings_usb_bluetooth_running">運行中 · 本地 MAC: %1$s · 廣播名稱: %2$s</string>
    <string name="settings_usb_bluetooth_self_test">自檢外置藍牙硬體與通訊</string>
    <string name="settings_usb_pairing_title">確認藍牙配對</string>
    <string name="settings_usb_pairing_message">收到 %1$s 的藍牙配對要求。\n請確認以下數字與 iPhone 顯示的一致：</string>
    <string name="settings_usb_pairing_countdown">將在 %1$d 秒後自動確認</string>
    <string name="settings_usb_bluetooth_diagnostic_description">外接藍牙診斷：檢查轉接器權限與 HCI 硬體，結束後恢復無線服務。檢測前請先中斷 CarPlay。硬體正常不代表 iPhone 配對及 CarPlay 已連線；連線失敗後請儲存報告。</string>
    <string name="settings_advanced_connection">進階連接</string>
    <string name="settings_direct_usbfs_mode">USB 直連模式（實驗性）</string>
    <string name="settings_media_volume">媒體音量</string>
    <string name="settings_navigation_volume">導航音量</string>
    <string name="settings_stream_volume_description">當車機只有一個總音量時，在 DiPlay 內部調整媒體與導航的相對音量。</string>
    <string name="settings_direct_usbfs_mode_description">適用於系統 USB 列表始終看不到 iPhone 的車機：繞過系統列表直接列舉並開啟裝置節點，可能需要 root。會在下次連接時生效，並重新連接 CarPlay。</string>
    <string name="settings_root_hotspot_mode">Root 熱點（hostapd）（實驗性）</string>
    <string name="settings_carplay_auto_disconnect_bt">CarPlay 期間關閉藍牙自動連接（實驗性）</string>
    <string name="settings_carplay_auto_disconnect_bt_description">有線或無線 CarPlay 連上後，關掉車機藍牙設定裡的全域「自動連接」，避免手機斷開通話藍牙後車機馬上再連上。同時像車機藍牙設定裡點「中斷連線」那樣，主動中斷已連接的手機。藍牙本身保持開著。工作階段結束時恢復原來的開關；如果應用程式異常退出，下次打開 DiPlay 會恢復。開啟「透過車輛藍牙播放 CarPlay 音訊」時本開關不起作用。下次連線時生效。</string>
    <string name="settings_telephony_downlink_via_music">通話下行改走音樂流（實驗性）</string>
    <string name="settings_telephony_downlink_via_music_description">通話下行改走音樂流而不是通話流，通話模式和麥克風上行不變。僅當通話流下行無聲、而媒體音訊有聲時使用。下次連線時生效。</string>
    <string name="settings_announcement_duck_media">播報時壓低媒體音量（實驗性）</string>
    <string name="settings_announcement_duck_media_description">導航、語音助理或通話聲音實際播放時，在 DiPlay 內壓低媒體音量，播報結束後約一秒恢復。僅對 DiPlay 自己播放的聲音有效，不改變系統音量。下次連線時生效。</string>
    <string name="settings_dock_bar_refront">置前任務收起底欄（實驗性）</string>
    <string name="settings_dock_bar_refront_description">部分車機桌面會把底欄壓在 CarPlay 畫面上，視窗被壓矮、畫面縮小並出現黑邊。DiPlay 偵測到這種擠壓時，會把自己的任務置前，這類桌面會隨之收起底欄。CarPlay 介面本身不會切換。下次連線時生效。</string>
    <string name="settings_hostapd_channel">熱點頻道</string>
    <string name="settings_hostapd_channel_description">僅 2.4 GHz（頻道 1–13），頻道 1 相容性最好。</string>
    <string name="hotspot_mode_hostapd">Root 熱點（hostapd）</string>
    <string name="hotspot_mode_hostapd_desc">僅適用於已 root 的車機：DiPlay 以 root 身份啟動系統 hostapd 並自行建立熱點。在下方設定名稱與密碼，iPhone 將加入這個熱點。</string>
    <string name="hotspot_hint_hostapd">Root 熱點：車機需要已 root。DiPlay 會自行建立熱點；請保持 iPhone 的 Wi-Fi 與藍牙打開。</string>
    <string name="hostapd_channel_1_13">頻道（1–13）</string>
    <string name="hostapd_channel_must_be_1_13">頻道須在 1 到 13 之間</string>
    <string name="settings_ecarx_hotspot_title">ECARX 原廠熱點</string>
    <string name="settings_ecarx_hotspot_description">下次連線或開啟 DiPlay 時，關閉一般 Wi-Fi 並開啟已儲存的原廠熱點，保留名稱和密碼。如需開機自動執行，請同時啟用「車機啟動後開啟」。此 Android 5.1 車機不需 ADB 授權。</string>
    <string name="settings_legacy_hotspot_title">車機熱點自動開啟</string>
    <string name="settings_legacy_hotspot_description">在下次連線或打開 DiPlay 時，自動關閉 Wi-Fi 並開啟已儲存的車機熱點。保持熱點名稱與密碼不變。如需開機自動啟動，請同時開啟「車機啟動後打開」。在此車機上無需 ADB 授權。</string>
    <string name="settings_media_focus_exclusive">媒體音訊焦點獨佔</string>
    <string name="settings_media_focus_exclusive_description">媒體改請求永久焦點，不再讓其他播放器壓低 CarPlay。只對會把 CarPlay 壓到無聲的車機有效；可能導致其他播放器無聲。下次連接生效。</string>
    <string name="settings_app_theme">外觀</string>
    <string name="settings_app_theme_auto">自動</string>
