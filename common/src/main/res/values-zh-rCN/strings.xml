    <string name="wired_no_tcp_replug_required">连接反复失败。请拔下 iPhone 重新插入，然后点击重试。</string>
    <string name="retry_carplay_connection">重新连接</string>
    <string name="carplay_dock">CarPlay 程序栏</string>
    <string name="carplay_dock_automatic">自动</string>
    <string name="carplay_dock_driver_side">驾驶员一侧</string>
    <string name="carplay_dock_bottom">底部</string>
    <string name="settings_dock_auto_hide">自动隐藏侧边栏</string>
    <string name="settings_dock_auto_hide_description">全屏显示右侧应用区域，从屏幕左侧边缘向右滑动即可呼出应用边栏</string>
    <string name="settings_force_square_corners">强制直角显示</string>
    <string name="settings_force_square_corners_description">禁用 CarPlay 画面的圆角切角；在直角车机屏幕上开启，避免边缘内容被遮挡。下次连接时生效。</string>
    <string name="carplay_dock_hint">CarPlay 显示应用、时钟和状态的位置。在“驾驶员一侧”和“底部”之间切换立即生效；“自动”由 iPhone 决定，重新连接后生效。</string>
    <string name="split_screen_areas">分屏中的 CarPlay</string>
    <string name="split_screen_areas_description">车机以分屏显示 DiPlay 时，CarPlay 会按该窗口重新绘制，而不是缩小并留黑边；返回全屏也无需重新连接。首次使用时会记住窗口大小，下次连接起画面完全贴合。程序栏设为“自动”时，CarPlay 会把它放在底部。下次连接时生效。</string>
    <string name="carplay_rotation">随屏幕旋转 CarPlay，无需重新连接</string>
    <string name="carplay_rotation_description">适用于屏幕可旋转的车机。CarPlay 会获得包含横屏和竖屏的方形画面，旋转屏幕时直接重新绘制，无需重新连接。更大的方形画面可能增加视频处理负担并降低流畅度，尤其是在大屏上选择“更清晰”时。如果很少旋转屏幕，关闭此选项可能有所帮助。自定义安全区域不适用于方形画面。下次连接时生效。</string>
    <string name="carplay_rotation_picture">方形画面</string>
    <string name="carplay_rotation_smoother">更流畅（1920）</string>
    <string name="carplay_rotation_sharper">更清晰（屏幕尺寸）</string>
    <string name="carplay_call_controls_experimental">CarPlay 通话按键（实验性）</string>
    <string name="carplay_call_controls_experimental_description">用方向盘按键接听和挂断 CarPlay 电话。广汽车机上：接听键接听，挂断键挂断或拒接，短按或长按语音键唤起 Siri，CarPlay 连接期间车机自带的语音助手和唤醒词暂停；CarPlay 连接期间不弹出车机自带的通话界面。DiLink 3 上的按键尚未验证。仍需实车测试。默认关闭；仪表通话卡片为独立设置。</string>
    <string name="side_panel">CarPlay 旁的侧边面板（实验性）</string>
    <string name="side_panel_description">CarPlay 可移到屏幕的三分之二，DiPlay 在其余部分显示自己的面板：横屏时在乘客一侧，竖屏时在底部（时钟，以及已读取时的电量）。可在会话菜单中显示或隐藏。下次连接时生效。</string>
    <string name="side_panel_show">侧边面板</string>
    <string name="side_panel_full_screen">⤢ 全屏</string>
    <string name="main_buffered_audio">缓冲音乐（实验性）</string>
    <string name="main_buffered_audio_description">支持此功能的应用（如 Apple Music）会提前发送约两分钟的音乐，因此短暂的 Wi-Fi 中断不会被听到。其他应用保持原样。会重新连接 CarPlay。</string>
    <string name="settings_car_bluetooth_audio">通过车辆蓝牙播放 CarPlay 音频（实验性）</string>
    <string name="settings_car_bluetooth_audio_description">DiPlay 不向 iPhone 提供 CarPlay 音频，因此音乐、导航和通话应通过 iPhone 与车辆的蓝牙连接传输。请保持 iPhone 与车辆配对，并将车辆音源设为蓝牙。如果声音改从 iPhone 播放，请关闭此选项。会重新连接 CarPlay。</string>
    <string name="settings_car_bluetooth_audio_dongle_warning">检测到外置 USB 蓝牙适配器。外置适配器本身不能播放音频——这个功能是让声音走 iPhone 与车机自带蓝牙的连接。如果车机自带蓝牙放不了声音（这正是大多数人用外置适配器的原因），打开后会完全没有声音。</string>
    <string name="settings_car_bluetooth_audio_enable_anyway">仍然开启</string>
    <string name="call_echo_cancellation">通话回声消除（实验性）</string>
    <string name="call_echo_cancellation_description">尝试减少 CarPlay 通话中发送给对方的扬声器回声。效果取决于车载主机。下次连接 CarPlay 时生效。</string>
    <string name="call_voice_filter">更清晰的通话人声（实验性）</string>
    <string name="call_voice_filter_description">削减 CarPlay 通话音频的低音。这可能改变人声的音色。下次连接 CarPlay 时生效。</string>
    <string name="settings_call_mic_compatibility">通话麦克风兼容模式（实验性）</string>
    <string name="settings_call_mic_compatibility_description">通话时使用标准车机麦克风输入（MIC）并跳过系统通信音频模式切换。解决全志等车机在微信或电话通话时对方听不到声音的问题。下次连接 CarPlay 时生效。</string>
    <string name="smooth_video">流畅视频（实验性）</string>
    <string name="smooth_video_description">按 iPhone 为每一帧标记的时间加上一段短延迟显示 CarPlay 主画面，而不是解码后立即显示。延迟会自动调整，让大多数帧能及时解码；仍未按时准备好的帧会立即显示。滚动可能更均匀，但触控响应会变慢。画面调整不适用。会重新连接 CarPlay。</string>
    <string name="car_button_in_carplay">CarPlay 中的车辆按钮</string>
    <string name="car_button_icon">图标</string>
    <string name="car_button_icon_custom">自定义图标</string>
    <string name="car_button_name">名称</string>
    <string name="car_button_description">CarPlay 会在应用列表中显示此图标和名称。点按即可返回车辆自带的界面。更改将在 CarPlay 下次连接时生效。自定义图片会自动缩小至不超过 512×512 像素、256 KB。</string>
    <string name="car_button_saved_next_connection">已保存。CarPlay 将在下次连接时显示新的图标和名称。</string>
    <string name="this_head_unit_has_no_image_picker">此车机没有图片选择器。</string>
    <string name="settings_interface_size">界面大小</string>
    <string name="settings_interface_size_auto">自动</string>
    <string name="settings_interface_size_hint">DiPlay 自身界面中文字和控件的大小。自动模式会在大尺寸低密度屏幕上放大它们。不影响 CarPlay。</string>
    <string name="settings_direct_surface_view">高效硬件图层渲染（实验性）</string>
    <string name="settings_direct_surface_view_description">使用系统原生硬件叠加图层（SurfaceView）显示画面，绕过 GPU 视图合成，大幅降低老旧低配车机（如安卓 4.4/6.0、联发科 MT3561、全志 T3）的系统负载与卡顿。开启后画面色彩调节不可用。会重新连接 CarPlay。</string>
    <string name="bluetooth_adapter_unavailable">车机未提供原生蓝牙适配器，无法进行无线连接引导。请在设置中切换为【有线连接】并使用 USB 数据线连接。</string>
    <string name="usb_iphone_busy_or_occupied">iPhone USB 接口被原车系统或其他应用占用（如原车 iPod 播放器），请在车机中退出该应用并重新拔插数据线。</string>
    <string name="wired_usb_stall_replug_required">iPhone 未响应 USB 配置请求（其 USB 状态已卡死）。请拔下数据线、重启 iPhone 并重新连接，然后点击重试。</string>
    <string name="usb_iphone_permission_not_granted">未能获取 iPhone USB 权限（可能被原车系统拦截或未弹出授权窗口），请尝试退出原车 iPod 播放器并重新插拔 USB。</string>
    <string name="bluetooth_device_connected">已连接</string>
    <string name="manual_input_mac">手动输入 MAC</string>
    <string name="manual_bluetooth_input_mac_label">蓝牙 MAC 地址（例如 AA:BB:CC:DD:EE:FF）：</string>
    <string name="manual_bluetooth_input_name_label">设备名称：</string>
    <string name="manual_bluetooth_input_invalid_mac">无效的 MAC 地址（格式为 XX:XX:XX:XX:XX:XX）</string>
    <string name="restart_application">重启应用</string>
    <string name="preset_brand_icons">选择品牌车标</string>
    <string name="car_brand_presets_title">选择汽车品牌车标</string>
    <string name="car_brand_icon_applied">已应用 %1$s 车标</string>
    <string name="settings_car_bluetooth_mac_title">车机蓝牙地址</string>
    <string name="settings_car_bluetooth_mac_subtitle">向 iPhone 宣告车机真实蓝牙 MAC 地址以正常路由音频。重新连接后生效。</string>
    <string name="settings_car_bluetooth_mac_auto">自动探测 (%1$s)</string>
    <string name="settings_car_bluetooth_mac_not_detected">未检测到</string>
    <string name="settings_car_bluetooth_mac_dialog_title">车机蓝牙 MAC 地址</string>
    <string name="settings_car_bluetooth_mac_dialog_message">输入车机真实蓝牙 MAC 地址（例如 AA:BB:CC:DD:EE:FF）。可在 iPhone「设置 → 蓝牙 → (i)」或车机蓝牙设置中查看。</string>
    <string name="settings_car_bluetooth_mac_clear">清除 / 自动探测</string>
    <string name="settings_bluetooth_diagnostic">蓝牙诊断</string>
    <string name="settings_log_output_title">日志输出</string>
    <string name="settings_log_output_subtitle">关闭可降低老车机负载，重启应用后生效；需要定位问题时再打开。</string>
    <string name="settings_car_bluetooth_mac_invalid">请输入有效的 12 位十六进制 MAC 地址。</string>
    <string name="report_no_usb_drive">未检测到可写入的U盘。请连接U盘后重试，或将报告保存到车机。</string>
    <string name="report_auto_save_locations">自动保存至所有可写位置</string>
    <string name="report_usb_location">U盘：%1$s</string>
    <string name="report_usb_copy_unavailable">U盘副本：未找到可写U盘</string>
    <string name="report_usb_copy_paths">另外保存到：\n%1$s</string>
    <string name="settings_harman_fullscreen_experimental">哈曼车机全屏（实验性）</string>
    <string name="settings_harman_fullscreen_experimental_description">让 CarPlay 占用受支持哈曼车机的原厂侧栏区域。下次打开 CarPlay 窗口时生效；其他固件可能显示异常。</string>
    <string name="settings_legacy_reverse_cold_start">倒车退出延迟冷启动（实验性）</string>
    <string name="settings_legacy_reverse_cold_start_description">针对老旧芯片（如 MTK 8227L）：挂倒挡时彻底释放视频解码器，退出倒挡 2.5 秒后再冷启动并索取全新关键帧。仅在倒车退出黑屏的车机上开启。</string>
    <string name="settings_usb_bluetooth_title">外置 USB 蓝牙</string>
    <string name="settings_usb_bluetooth_subtitle">直接驱动外置 USB 蓝牙适配器（支持绿联 CM591/CM390、Realtek、炬芯 ATS2851 等），用于无线 CarPlay 数据通道。</string>
    <string name="settings_usb_bluetooth_not_detected">未检测到外置 USB 蓝牙适配器 — 请插入兼容的 USB 蓝牙设备。</string>
    <string name="settings_usb_bluetooth_detected">已识别: %1$s</string>
    <string name="settings_usb_bluetooth_needs_permission">未获取 USB 访问权限 — 点击请求授权</string>
    <string name="settings_usb_bluetooth_request_permission">授予 USB 权限</string>
    <string name="settings_usb_bluetooth_start">启动外置蓝牙服务与广播配对</string>
    <string name="settings_usb_bluetooth_stop">停止外置蓝牙服务</string>
    <string name="settings_usb_bluetooth_running">运行中 · 本地 MAC: %1$s · 广播名称: %2$s</string>
    <string name="settings_usb_bluetooth_self_test">自检外置蓝牙硬件与通讯</string>
    <string name="settings_usb_pairing_title">确认蓝牙配对</string>
    <string name="settings_usb_pairing_message">收到 %1$s 的蓝牙配对请求。\n请确认以下数字与 iPhone 上显示的一致：</string>
    <string name="settings_usb_pairing_countdown">将在 %1$d 秒后自动确认</string>
    <string name="settings_usb_bluetooth_diagnostic_description">外置蓝牙诊断：检查适配器权限和 HCI 硬件，结束后恢复无线服务。检测前请先断开 CarPlay。硬件正常不代表 iPhone 配对和 CarPlay 已连接；连接失败后请保存报告。</string>
    <string name="settings_advanced_connection">高级连接</string>
    <string name="settings_direct_usbfs_mode">USB 直连模式（实验性）</string>
    <string name="settings_media_volume">媒体音量</string>
    <string name="settings_navigation_volume">导航音量</string>
    <string name="settings_stream_volume_description">当车机只有一个总音量时，在 DiPlay 内部调整媒体与导航的相对音量。</string>
    <string name="settings_direct_usbfs_mode_description">适用于系统 USB 列表始终看不到 iPhone 的车机：绕过系统列表直接枚举并打开设备节点，可能需要 root。会在下次连接时生效，并重新连接 CarPlay。</string>
    <string name="settings_root_hotspot_mode">Root 热点（hostapd）（实验性）</string>
    <string name="settings_carplay_auto_disconnect_bt">CarPlay 期间关闭蓝牙自动连接（实验性）</string>
    <string name="settings_carplay_auto_disconnect_bt_description">有线或无线 CarPlay 连上后，关掉车机蓝牙设置里的全局「自动连接」，避免手机断开通话蓝牙后车机马上再连上。同时像车机蓝牙设置里点「断开」那样，主动断开已连接的手机。蓝牙本身保持开着。会话结束时恢复原来的开关；如果应用异常退出，下次打开 DiPlay 会恢复。开启「通过车辆蓝牙播放 CarPlay 音频」时本开关不起作用。下次连接时生效。</string>
    <string name="settings_telephony_downlink_via_music">通话下行改走音乐流（实验性）</string>
    <string name="settings_telephony_downlink_via_music_description">通话下行改走音乐流而不是通话流，通话模式和麦克风上行不变。仅当通话流下行无声、而媒体音频有声时使用。下次连接时生效。</string>
    <string name="settings_announcement_duck_media">播报时压低媒体音量（实验性）</string>
    <string name="settings_announcement_duck_media_description">导航、语音助手或通话声音实际播放时，在 DiPlay 内压低媒体音量，播报结束后约一秒恢复。仅对 DiPlay 自己播放的声音有效，不改变系统音量。下次连接时生效。</string>
    <string name="settings_dock_bar_refront">置前任务收起底栏（实验性）</string>
    <string name="settings_dock_bar_refront_description">部分车机桌面会把底栏压在 CarPlay 画面上，窗口被压矮、画面缩小并出现黑边。DiPlay 检测到这种挤压时，会把自己的任务置前，这类桌面会随之收起底栏。CarPlay 界面本身不会切换。下次连接时生效。</string>
    <string name="settings_hostapd_channel">热点信道</string>
    <string name="settings_hostapd_channel_description">仅 2.4 GHz（信道 1–13），信道 1 兼容性最好。</string>
    <string name="hotspot_mode_hostapd">Root 热点（hostapd）</string>
    <string name="hotspot_mode_hostapd_desc">仅适用于已 root 的车机：DiPlay 以 root 身份启动系统 hostapd 并自行创建热点。在下方设置名称与密码，iPhone 将加入这个热点。</string>
    <string name="hotspot_hint_hostapd">Root 热点：车机需要已 root。DiPlay 会自行创建热点；请保持 iPhone 的 Wi-Fi 与蓝牙打开。</string>
    <string name="hostapd_channel_1_13">信道（1–13）</string>
    <string name="hostapd_channel_must_be_1_13">信道须在 1 到 13 之间</string>
    <string name="settings_ecarx_hotspot_title">ECARX 原厂热点</string>
    <string name="settings_ecarx_hotspot_description">下次连接或打开 DiPlay 时，关闭普通 Wi-Fi 并开启已保存的原厂热点，保留名称和密码。如需开机自动运行，请同时开启“车机启动后打开”。此 Android 5.1 车机无需 ADB 授权。</string>
    <string name="settings_legacy_hotspot_title">车机热点自动开启</string>
    <string name="settings_legacy_hotspot_description">在下次连接或打开 DiPlay 时，自动关闭 Wi-Fi 并开启已保存的车机热点。保持热点名称与密码不变。如需开机自动启动，请同时开启“车机启动后打开”。在此车机上无需 ADB 授权。</string>
    <string name="settings_media_focus_exclusive">媒体音频焦点独占</string>
    <string name="settings_media_focus_exclusive_description">媒体改请求永久焦点，不再让其他播放器压低 CarPlay。只对会把 CarPlay 压到无声的车机有效；可能导致其他播放器无声。下次连接生效。</string>
    <string name="settings_app_theme">外观</string>
    <string name="settings_app_theme_auto">自动</string>
    <string name="settings_app_theme_light">浅色</string>
    <string name="settings_app_theme_dark">深色</string>
    <string name="settings_app_theme_hint">DiPlay 自身界面使用浅色还是深色。自动时跟随 CarPlay 的日夜模式设置。不影响 CarPlay 画面。</string>
    <string name="home_wired_carplay">有线 CarPlay</string>
    <string name="quick_call_keys_note">接听键接听，挂断键挂断，长按语音键唤起 Siri。立即生效。</string>
    <string name="quick_auto_connect_note">避免车机把手机重新连回蓝牙。重新连接后生效。</string>
    <string name="quick_cluster_map_note">重新连接后生效。</string>
    <string name="quick_back_to_home">返回首页</string>
    <string name="wireless_mode_recommended">推荐 · 已在本车验证</string>
    <string name="wireless_mode_not_recommended">其他方式 · 未在本车验证，不推荐</string>
    <string name="station_wifi_pause_title">暂停车机 Wi-Fi</string>
    <string name="station_wifi_pause_message">车机 Wi-Fi 正连着「%1$s」。无线 CarPlay 用的 Wi-Fi 直连和它共用同一个 2.4 GHz 无线模块，两边会轮流占用，影响稳定。%2$d 秒后断开车机 Wi-Fi，CarPlay 结束后自动重新连接。</string>
    <string name="station_wifi_pause_keep">保持 Wi-Fi</string>
    <string name="station_wifi_pause_now">立即断开</string>
    <string name="station_wifi_pause_unknown_network">一个网络</string>
    <string name="settings_guidance_keep_music">导航播报时保持音乐音量（实验性）</string>
    <string name="settings_guidance_keep_music_description">仅广汽车机。导航播报时车机会把音乐压低约 15 dB；打开后 DiPlay 会把音乐调回车机自己的低音量规则，只轻微压低。从下一次播报起生效。</string>
</resources>
