<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!-- Guangqi: stops the stock CarLife once CarPlay is up, so DiPlay can take the wheel call keys. -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" tools:ignore="ProtectedPermissions" />

    <uses-sdk tools:overrideLibrary="androidx.media3.ui,androidx.media3.extractor,androidx.media3.exoplayer,androidx.media3.exoplayer.hls,androidx.media3.common,androidx.media3.datasource,androidx.media3.database,androidx.media3.container,androidx.media3.decoder,androidx.media,androidx.core,androidx.core.ktx,androidx.annotation.experimental" />
    <application
        android:name="com.shilapi.xcertplay.DiPlayApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_carplay"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/ic_carplay"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.Xcertplay">

        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            android:value="true" />

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            tools:replace="android:enabled" />

        <!-- Guangqi volume keys: runs in system_server, as the ROM's SettingsProvider does.
             See GuangqiVolumeHook. -->
        <receiver
            android:name="com.shilapi.xcertplay.orchestration.GuangqiVolumeHookReceiver"
            android:exported="false"
            android:process="system" />

    </application>

</manifest>
